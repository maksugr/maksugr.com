---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { Talk } from "@/data/talks";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import TalkListCard from "@/components/TalkListCard.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { TALKS } from "@/data/talks";

type FeedItem =
  | { type: "post"; post: CollectionEntry<"blog"> }
  | { type: "talk"; talk: Talk };

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

const allItems: FeedItem[] = [
  ...sortedPosts.map(post => ({ type: "post" as const, post })),
  ...TALKS.map(talk => ({ type: "talk" as const, talk })),
].sort((a, b) => {
  const dateA = a.type === "post"
    ? new Date(a.post.data.modDatetime ?? a.post.data.pubDatetime).getTime()
    : a.talk.pubDatetime.getTime();
  const dateB = b.type === "post"
    ? new Date(b.post.data.modDatetime ?? b.post.data.pubDatetime).getTime()
    : b.talk.pubDatetime.getTime();
  return dateB - dateA;
});

const pageSize = SITE.postPerPage;
const totalPages = Math.ceil(allItems.length / pageSize);
const pageItems = allItems.slice(0, pageSize);

const page = {
  data: pageItems,
  currentPage: 1,
  lastPage: totalPages,
  url: {
    prev: undefined as string | undefined,
    next: totalPages > 1 ? "/page/2" : undefined as string | undefined,
  },
};
---

<Layout>
  <Header activeTab="all" />
  <main id="main-content" data-layout="index" class="app-layout">
    <section class="pb-6 pt-4">
      <ul>
        {
          page.data.map(item =>
            item.type === "post" ? (
              <Card variant="h3" {...item.post} />
            ) : (
              <TalkListCard variant="h3" {...item.talk} />
            )
          )
        }
      </ul>
    </section>
  </main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
