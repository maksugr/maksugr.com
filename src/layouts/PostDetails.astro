---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Discussions from "@/components/Discussions.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { Icon } from "astro-icon/components";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  discussions,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <h1
      class="inline-block text-4xl font-heading tracking-tight sm:text-5xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    <p class="mt-6 border-l-4 border-foreground/30 pl-4 text-foreground/70 italic text-base">
      {description}
    </p>
    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-8 border-t-2 border-border" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-2 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    {discussions && discussions.length > 0 && <Discussions discussions={discussions} open />}

    {
      (prevPost || nextPost) && <hr class="my-6 border-t-2 border-border" />
    }

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 border-2 border-foreground p-3 overflow-hidden transition-colors hover:bg-foreground hover:text-background"
          >
            <Icon name="carbon:chevron-left" class="inline-block flex-none size-5 mt-0.5" />
            <div>
              <span class="font-heading text-base">Previous</span>
              <div class="text-sm">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end border-2 border-foreground p-3 overflow-hidden transition-colors hover:bg-foreground hover:text-background sm:col-start-2"
          >
            <div>
              <span class="font-heading text-base">Next</span>
              <div class="text-sm">{nextPost.title}</div>
            </div>
            <Icon name="carbon:chevron-right" class="inline-block flex-none size-5 mt-0.5" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-0.5 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-0.5 w-0 bg-foreground";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} bg-muted border-2 border-foreground px-2 py-1 text-xs leading-4 text-foreground font-bold uppercase`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Spoiler with random particles */
  document.querySelectorAll(".spoiler").forEach(el => {
    const canvas = document.createElement("canvas");
    el.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    const density = 2;
    let particles = [];
    let animId;

    function resize() {
      const rect = el.getBoundingClientRect();
      canvas.width = rect.width * devicePixelRatio;
      canvas.height = rect.height * devicePixelRatio;
      const count = Math.max(5, Math.floor(canvas.width * canvas.height * density / 100));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: (Math.random() * 0.6 + 0.3) * devicePixelRatio,
        phase: Math.random() * Math.PI * 2,
        freq: Math.random() * 0.067 + 0.017,
      }));
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const fg = getComputedStyle(document.documentElement).getPropertyValue("--foreground").trim();
      ctx.fillStyle = fg;
      for (const p of particles) {
        p.phase += p.freq;
        const alpha = (Math.sin(p.phase) + 1) / 2;
        ctx.globalAlpha = alpha * 0.7;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      animId = requestAnimationFrame(draw);
    }

    resize();
    draw();

    el.addEventListener("click", () => {
      el.classList.toggle("revealed");
      if (el.classList.contains("revealed")) {
        cancelAnimationFrame(animId);
      } else {
        resize();
        draw();
      }
    });
  });

  /** Render mermaid code blocks */
  async function renderMermaid() {
    const pres = document.querySelectorAll('pre[data-language="mermaid"]');
    if (!pres.length) return;

    const sources = [];
    for (const pre of pres) {
      const source = pre.querySelector("code").textContent;
      const placeholder = document.createElement("div");
      placeholder.style.cssText = "display:flex;align-items:center;justify-content:center;min-height:12rem;opacity:0.4;font-style:italic;";
      placeholder.textContent = "Loading diagram…";
      pre.replaceWith(placeholder);
      sources.push({ placeholder, source });
    }

    const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
    const isDark = document.documentElement.dataset.theme === "dark";
    const lightTheme = {
      theme: "base",
      themeVariables: {
        background: "transparent",
        primaryColor: "#e8e8e8", secondaryColor: "#d0d0d0", tertiaryColor: "#c0c0c0",
        mainBkg: "#f0f0f0", nodeBkg: "#f0f0f0", clusterBkg: "#f5f5f5", clusterBorder: "#0a0a0a",
        nodeBorder: "#0a0a0a", lineColor: "#0a0a0a", textColor: "#0a0a0a", titleColor: "#0a0a0a",
        pieStrokeColor: "#0a0a0a", pieSectionTextColor: "#0a0a0a", pieLegendTextColor: "#0a0a0a",
        pie1: "#c0392b", pie2: "#2c3e50",
        xyChart: { backgroundColor: "transparent", plotColorPalette: "#c0392b",
          xAxisLabelColor: "#0a0a0a", yAxisLabelColor: "#0a0a0a", xAxisTitleColor: "#0a0a0a", yAxisTitleColor: "#0a0a0a",
          xAxisTickColor: "#0a0a0a", yAxisTickColor: "#0a0a0a", xAxisLineColor: "#0a0a0a", yAxisLineColor: "#0a0a0a", titleColor: "#0a0a0a" },
      },
    };

    const darkTheme = {
      theme: "base",
      themeVariables: {
        background: "transparent",
        primaryColor: "#333333", secondaryColor: "#444444", tertiaryColor: "#555555",
        mainBkg: "#1a1a1a", nodeBkg: "#1a1a1a", clusterBkg: "#1a1a1a", clusterBorder: "#f0f0f0",
        nodeBorder: "#f0f0f0", lineColor: "#f0f0f0", textColor: "#f0f0f0", titleColor: "#f0f0f0",
        pieStrokeColor: "#f0f0f0", pieSectionTextColor: "#f0f0f0", pieLegendTextColor: "#f0f0f0",
        pie1: "#e74c3c", pie2: "#3498db",
        xyChart: { backgroundColor: "transparent", plotColorPalette: "#e74c3c",
          xAxisLabelColor: "#f0f0f0", yAxisLabelColor: "#f0f0f0", xAxisTitleColor: "#f0f0f0", yAxisTitleColor: "#f0f0f0",
          xAxisTickColor: "#f0f0f0", yAxisTickColor: "#f0f0f0", xAxisLineColor: "#f0f0f0", yAxisLineColor: "#f0f0f0", titleColor: "#f0f0f0" },
      },
    };

    let renderCount = 0;

    async function renderAll() {
      const isDark = document.documentElement.dataset.theme === "dark";
      const config = isDark ? darkTheme : lightTheme;
      mermaid.initialize({ startOnLoad: false, ...config });
      renderCount++;

      for (const [i, { source }] of sources.entries()) {
        const containerId = `mermaid-container-${i}`;
        let container = document.getElementById(containerId);
        if (!container) {
          container = document.createElement("div");
          container.id = containerId;
          container.className = "mermaid-diagram";
          sources[i].placeholder.replaceWith(container);
          sources[i].container = container;
        }
        try {
          const { svg } = await mermaid.render(`mermaid-r${renderCount}-${i}`, source);
          container.innerHTML = svg;
        } catch (e) {
          container.innerHTML = `<span style="color:red">Diagram error: ${e.message}</span>`;
          console.error("Mermaid render error:", e);
        }
      }
    }

    await renderAll();

    const themeBtn = document.getElementById("theme-btn");
    if (themeBtn) {
      themeBtn.addEventListener("click", () => {
        setTimeout(renderAll, 100);
      });
    }
  }
  renderMermaid();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
